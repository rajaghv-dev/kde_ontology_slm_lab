<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name="minisearchrc"/>
  <group name="Search">
    <entry name="MaxResults" type="Int">
      <label>Maximum number of results to display</label>
      <default>100</default>
      <min>1</min>
      <max>10000</max>
    </entry>
    <entry name="IncludeHidden" type="Bool">
      <label>Include hidden files in search</label>
      <default>false</default>
    </entry>
    <entry name="DefaultPath" type="Path">
      <label>Default path to search when none provided</label>
      <default>$HOME</default>
    </entry>
  </group>
  <group name="Ui">
    <entry name="ThumbnailEnabled" type="Bool">
      <label>Show thumbnails next to result paths</label>
      <default>true</default>
    </entry>
  </group>
</kcfg>
